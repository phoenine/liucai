{
  "name": "liucai",
  "version": "0.1.0",
  "private": true,
  "description": "六彩：local-first Chrome web highlighter with optional Supabase sync.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "npm run build && node scripts/package-extension.mjs",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local",
    "supabase:test": "supabase test db --local",
    "supabase:lint": "supabase db lint --local --level warning"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "dexie": "^4.0.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.306",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.5",
    "supabase": "^2.117.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.12"
  }
}
